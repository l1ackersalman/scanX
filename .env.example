# =====================================================================
# scanX configuration — copy to .env and fill in. Never commit .env.
# =====================================================================

# ---- Django ----------------------------------------------------------
# Keep DEBUG=False on a public server (error pages would show code/settings).
# Set DEBUG=True only on your own machine while developing.
DEBUG=False

# Leave empty to let scanX generate a private key once (saved in .secret_key).
# Or set your own: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Hostnames/IPs the site is served on (comma-separated), e.g. scanx.example.com,203.0.113.7
ALLOWED_HOSTS=localhost,127.0.0.1

# Full public URLs the site is opened from, needed for forms behind a domain/HTTPS,
# e.g. https://scanx.example.com,http://203.0.113.7:8000
CSRF_TRUSTED_ORIGINS=

# Web server bind address and port used by scripts/start.sh
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8000

# ---- Scanner ---------------------------------------------------------
# Where scan outputs are stored (absolute path recommended in production)
SCANX_DATA_DIR=./scan_data

# Chaos API key for the chaos tool: https://chaos.projectdiscovery.io/
CHAOS_API_KEY=

# Extra PATH entries for the recon tools (colon-separated)
TOOLS_PATH=/usr/local/go/bin:$HOME/go/bin

# Max scan time in seconds (default 1 hour)
SCAN_TIMEOUT=3600

# Max scans waiting in the queue (stops one visitor filling it)
SCAN_QUEUE_LIMIT=5

# ---- Database --------------------------------------------------------
# SQLite by default. For PostgreSQL: DATABASE_URL=postgres://user:pass@host:5432/db
DATABASE_URL=sqlite:///db.sqlite3

# ---- Built-in AI ("Generate AI report" button) -----------------------
# Set ONE provider's key. scanX pays per report with this key.
# AI_PROVIDER: anthropic | openai | nvidia  (empty = first key found)
AI_PROVIDER=

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_MODEL_ANTHROPIC=claude-opus-5-5

# OpenAI — https://platform.openai.com/
OPENAI_API_KEY=
AI_MODEL_OPENAI=gpt-5

# NVIDIA NIM, e.g. Nemotron — https://build.nvidia.com/ (key starts with nvapi-)
# Copy the exact model id from the model's page.
NVIDIA_API_KEY=
AI_MODEL_NVIDIA=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Usage limits for the built-in AI
AI_DAILY_LIMIT=30
AI_SCAN_COOLDOWN_MINUTES=10
AI_MAX_TURNS=25
AI_JOB_TIMEOUT=600

api_key=