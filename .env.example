# Django
DEBUG=True
SECRET_KEY=changeme-in-production-use-django-secret-key-generator
ALLOWED_HOSTS=localhost,127.0.0.1

# ScanX Data Directory (where scan outputs are stored)
# Use absolute path in production, relative for development
SCANX_DATA_DIR=./scan_data

# External Tool API Keys
# Get your Chaos API key from https://chaos.projectdiscovery.io/
CHAOS_API_KEY=your_chaos_api_key_here

# Tool PATH additions (colon-separated)
# Add Go bin paths if tools aren't in system PATH
TOOLS_PATH=/usr/local/go/bin:$HOME/go/bin

# Scan timeout in seconds (default: 1 hour)
SCAN_TIMEOUT=3600

# Database (SQLite for development)
# For production, use PostgreSQL: DATABASE_URL=postgres://user:pass@host:port/db
DATABASE_URL=sqlite:///db.sqlite3